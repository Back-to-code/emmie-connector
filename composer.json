{
    "name": "back-to-code/emmie-connector",
    "description": "Connects a WordPress site to Emmie: an intake form that adds a new client, and Emmie's booking form for introductory meetings.",
    "type": "wordpress-plugin",
    "license": "GPL-2.0-or-later",
    "homepage": "https://emmie.nl",
    "authors": [
        {
            "name": "Emmie B.V.",
            "homepage": "https://emmie.nl"
        }
    ],
    "support": {
        "issues": "https://github.com/Back-to-code/emmie-connector/issues",
        "source": "https://github.com/Back-to-code/emmie-connector"
    },
    "require": {
        "php": ">=8.0",
        "composer/installers": "^2.0"
    },
    "require-dev": {
        "dealerdirect/phpcodesniffer-composer-installer": "^1.0",
        "phpcompatibility/phpcompatibility-wp": "^2.1",
        "wp-coding-standards/wpcs": "^3.1"
    },
    "config": {
        "allow-plugins": {
            "composer/installers": true,
            "dealerdirect/phpcodesniffer-composer-installer": true
        },
        "sort-packages": true
    },
    "scripts": {
        "lint": "find . -name '*.php' -not -path './vendor/*' -print0 | xargs -0 -n1 php -l",
        "phpcs": "phpcs"
    }
}
