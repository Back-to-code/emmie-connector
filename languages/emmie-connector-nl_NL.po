#. Plugin Name of the plugin
#: emmie-connector.php
msgid "Emmie Connector"
msgstr "Emmie Connector"

#. Description of the plugin
#: emmie-connector.php
msgid ""
"Connects your website to Emmie: an intake form that adds a new client to "
"your Emmie, and Emmie's booking form for introductory meetings."
msgstr ""
"Verbindt uw website met Emmie: een aanmeldformulier dat een nieuwe cliënt "
"in uw Emmie zet, en het boekformulier van Emmie voor kennismakingsgesprekken."

#. Author of the plugin
#: emmie-connector.php
msgid "Emmie B.V."
msgstr "Emmie B.V."

#. Author URI of the plugin
#: emmie-connector.php
msgid "https://emmie.nl"
msgstr "https://emmie.nl"

