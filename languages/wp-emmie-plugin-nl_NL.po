#. Plugin Name of the plugin
msgid "WP Emmie Plugin"
msgstr "WP Emmie Plugin"

#. Description of the plugin
msgid "Shares client data from your Wordpress site to Emmie"
msgstr "Deel cliëntgegevens via uw Wordpress site met Emmie"

#. Author of the plugin
msgid "Script"
msgstr "Script"

#. Author URI of the plugin
msgid "https://emmie.nl"
msgstr "https://emmie.nl"

#: admin-settings.php
msgid "Emmie API Settings"
msgstr "Emmie API Instellingen"

#: admin-settings.php
msgid "API URL"
msgstr "API URL"

#: admin-settings.php
msgid "API Token"
msgstr "API Token"

#: admin-settings.php
msgid "reCAPTCHA v3 Site Key"
msgstr "reCAPTCHA v3 Site Sleutel"

#: admin-settings.php
msgid "reCAPTCHA v3 Secret Key"
msgstr "reCAPTCHA v3 Geheime Sleutel"

#: admin-settings.php
msgid "Configure Emmie API Connection"
msgstr "Emmie API verbinding configureren"

#: admin-settings.php
msgid "Welcome! Please enter your Emmie API credentials to begin using the plugin."
msgstr "Welkom! Vul alstublieft uw Emmie API gegevens in om de plugin te gebruiken."

#: admin-settings.php
msgid "You can find your API credentials in your Emmie app under Settings > Inflow."
msgstr "U kunt uw API gegevens vinden in uw Emmie app onder Instellingen > Instroom."

#: admin-settings.php
msgid "Save & Activate"
msgstr "Opslaan & Activeren"

#: admin-settings.php
msgid "Save Changes"
msgstr "Wijzigingen Opslaan"

#: admin-settings.php
msgid "API URL and Token are required"
msgstr "API URL and Token zijn verplicht"

#: admin-settings.php
msgid "Could not connect to the Emmie API: "
msgstr "Kan niet verbinden met de Emmie API: "

#: admin-settings.php
msgid "API token validation failed"
msgstr "API Token validatie mislukt"

#: admin-settings.php
msgid "Please check whether your API URL is correct."
msgstr "Controleer alstublieft of uw API URL correct is."

#: admin-settings.php
msgid "Please check your token."
msgstr "Controleer alstublieft uw Token."

#: admin-settings.php
msgid "API token validated successfully."
msgstr "API Token succesvol gevalideerd."

#: admin-settings.php
msgid "✅ API token validated successfully. The kennismaken page has been created:"
msgstr "API Token succesvol gevalideerd.  De pagina \"kennismaken\" is aangemaakt:"

#: form-handler.php
msgid "The form is not available"
msgstr "Het formulier is niet beschikbaar"

#: form-handler.php
msgid "First Name"
msgstr "Voornaam"

#: form-handler.php
msgid "Last Name"
msgstr "Achternaam"

#: form-handler.php
msgid "Email Address"
msgstr "E-mailadres"

#: form-handler.php
msgid "Telephone Number"
msgstr "Telefoonnummer"

#: form-handler.php
msgid "Street"
msgstr "Straat"

#: form-handler.php
msgid "House Number"
msgstr "Huisnummer"

#: form-handler.php
msgid "Addition"
msgstr "Toevoeging"

#: form-handler.php
msgid "Zipcode"
msgstr "Postcode"

#: form-handler.php
msgid "City"
msgstr "Plaats"

#: form-handler.php
msgid "Which location are you interested in?"
msgstr "Ik heb interesse in de Scriptvestiging in:"

#: form-handler.php
msgid "Select a location"
msgstr "Selecteer een locatie"

#: form-handler.php
msgid "Income Situation"
msgstr "Inkomenssituatie"

#: form-handler.php
msgid "Select income situation"
msgstr "Selecteer inkomenssituatie"

#: form-handler.php
msgid "Contact Preference"
msgstr "Contactvoorkeur"

#: form-handler.php
msgid "Select contact preference"
msgstr "Selecteer contactvoorkeur"

#: form-handler.php
msgid "Add contact person"
msgstr "Begeleider of contactpersoon toevoegen"

#: form-handler.php
msgid "Contact First Name"
msgstr "Voornaam contactpersoon"

#: form-handler.php
msgid "Contact Last Name"
msgstr "Achternaam contactpersoon"

#: form-handler.php
msgid "Organisation"
msgstr "Organisatie"

#: form-handler.php
msgid "Contact Email"
msgstr "E-mailadres contactpersoon"

#: form-handler.php
msgid "Contact Phone Number"
msgstr "Telefoonnummer contactpersoon"

#: form-handler.php
msgid "The organisation may contact this person before the first meeting"
msgstr "De organisatie mag contact opnemen met deze persoon vóór het eerste gesprek"

#: form-handler.php
msgid "How did you find us?"
msgstr "Hoe heb je ons gevonden?"

#: form-handler.php
msgid "Select an option"
msgstr "Selecteer een optie"

#: form-handler.php
msgid "Please specify"
msgstr "Geef aan"

#: form-handler.php
msgid "Documents"
msgstr "Upload je CV (optioneel)"

#: form-handler.php
msgid "Allowed formats: doc, docx, rtf, xls, xlsx, txt, jpg, jpeg, png, pdf. Max 40MB per file."
msgstr "Toegestane formaten: doc, docx, rtf, xls, xlsx, txt, jpg, jpeg, png, pdf. Maximaal 40MB per bestand."

#: form-handler.php
msgid "Comments"
msgstr "Opmerkingen"

#: form-handler.php
msgid "Personal Data"
msgstr "Persoonsgegevens"

#: form-handler.php
#, php-format
msgid "By checking this box, you agree to the processing of your personal data according to the <a href=\"%s\" target=\"_blank\">privacy statement</a>"
msgstr "Door bovenstaande te selecteren gaat u akkoord met de verwerking van uw persoonsgegevens volgens de <a href=\"%s\" target=\"_blank\">privacyverklaring</a>"

#: admin-settings.php
#, php-format
msgid "The intake form links to Emmie's privacy statement, because this site has none. Choose your own privacy statement under <a href=\"%s\">Settings &gt; Privacy</a>: the personal data from the form are yours."
msgstr "Het aanmeldformulier linkt naar de privacyverklaring van Emmie, omdat deze site er geen heeft. Kies uw eigen privacyverklaring onder <a href=\"%s\">Instellingen &gt; Privacy</a>: de persoonsgegevens uit het formulier zijn van uw organisatie."

#: form-handler.php
msgid "Submit"
msgstr "Verzenden"

#: form-handler.php
msgid "Security check failed. Please reload the page and try again."
msgstr "Beveiligingscontrole mislukt. Laad de pagina opnieuw en probeer het nog eens."

#: form-handler.php
msgid "You must agree to share the submitted personal data"
msgstr "Je moet akkoord gaan met de verwerking van uw persoonsgegevens"

#: form-handler.php
msgid "First Name is required"
msgstr "Voornaam is verplicht"

#: form-handler.php
msgid "Last Name is required"
msgstr "Achternaam is verplicht"

#: form-handler.php
msgid "Please enter a valid email address"
msgstr "Vul een geldig e-mailadres in"

#: form-handler.php
msgid "Please enter a valid phone number"
msgstr "Vul een geldig telefoonnummer in"

#: form-handler.php
msgid "How did you find us:"
msgstr "Hoe bij ons terechtgekomen:"

#: form-handler.php
msgid "Please complete the reCAPTCHA verification."
msgstr "Bevestig alstublieft de reCAPTCHA verificatie."

#: form-handler.php
msgid "reCAPTCHA verification failed. Please try again."
msgstr "reCAPTCHA verificatie mislukt."

#: form-handler.php
msgid "Please correct the errors above before submitting."
msgstr "Verbeter alstublieft de fouten in het formulier voordat u op Verzenden klikt."

#: form-handler.php
msgid "API not configured. Please contact support."
msgstr "API niet ingesteld. Neemt alstublieft contact op met de beheerder."

#: form-handler.php
msgid "Submission failed:"
msgstr "Verzending mislukt:"

#: form-handler.php
msgid "Thank you! Your information has been submitted."
msgstr "Bedankt! Je informatie is gedeeld."

#: wp-emmie-plugin.php
msgid "Something went wrong"
msgstr "Er is iets fout gegaan"

#: wp-emmie-plugin.php
msgid "Deactivate"
msgstr "Deactiveren"

#: wp-emmie-plugin.php
msgid "Do you want to delete all WP to emmie Connector settings and data?"
msgstr "Wilt u alle WP Emmie instellingen en data verwijderen?"

#: booking-form.php
msgid "The booking form is not shown: enter a valid Emmie API URL and token in the plugin settings. Visitors see nothing here."
msgstr "Het boekformulier wordt niet getoond: vul een geldige Emmie API URL en token in bij de instellingen van de plugin. Bezoekers zien hier niets."

#: form-handler.php
msgid "Plan an introductory meeting"
msgstr "Plan een kennismakingsgesprek"

#: admin-settings.php
msgid "Booking form"
msgstr "Boekformulier"

#: admin-settings.php
msgid "Neutral base style from Emmie"
msgstr "Neutrale basisopmaak van Emmie"

#: admin-settings.php
msgid "Without it, your theme styles the booking form of [emmie_kennismaking] entirely. A shortcode can choose per page with opmaak=\"basis\" or opmaak=\"geen\"."
msgstr "Zonder basisopmaak bepaalt uw thema hoe het boekformulier van [emmie_kennismaking] eruitziet. Een shortcode kan per pagina kiezen met opmaak=\"basis\" of opmaak=\"geen\"."
